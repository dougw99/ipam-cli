# Copy to .env and fill in your Azure Database for PostgreSQL credentials.
# Never commit .env.
#
# Username format for Azure PostgreSQL includes the server name,
# e.g. ipamadmin@my-ipam-server
# Use sslmode=require (Azure PostgreSQL does not allow non-SSL connections).
IPAM_DB_URL=postgresql://ipamadmin:CHANGE_ME@my-ipam-server.postgres.database.azure.com:5432/ipam?sslmode=require
